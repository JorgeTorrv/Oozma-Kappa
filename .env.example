# Copia este archivo a .env y ajusta los valores. NUNCA subas .env.

# ─────────────────────────────────────────────────────────────────────────────
# Base de datos — PostgreSQL (Supabase / Neon / Postgres local)
# ─────────────────────────────────────────────────────────────────────────────
# DATABASE_URL: cadena CON pooling (para la app en runtime).
#   Supabase → Project Settings ▸ Database ▸ Connection string ▸ "Transaction"
#   (puerto 6543). Añade  ?pgbouncer=true&connection_limit=1
# DIRECT_URL: cadena SIN pooling (para migraciones / prisma db push).
#   Supabase → misma pantalla ▸ "Session" (puerto 5432).
DATABASE_URL="postgresql://postgres.xxxx:PASSWORD@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres.xxxx:PASSWORD@aws-0-region.pooler.supabase.com:5432/postgres"

# Postgres local (alternativa para desarrollo):
# DATABASE_URL="postgresql://postgres@localhost:5432/acopio_dev"
# DIRECT_URL="postgresql://postgres@localhost:5432/acopio_dev"

# ─────────────────────────────────────────────────────────────────────────────
# Entorno
# ─────────────────────────────────────────────────────────────────────────────
NODE_ENV="development"

# "false" desactiva el flujo de aprobación de mermas.
# WASTE_APPROVAL_ENABLED="true"

# ─────────────────────────────────────────────────────────────────────────────
# Mapa (opcional)
# ─────────────────────────────────────────────────────────────────────────────
# Si se define, el mapa y el selector de ubicación usan Google Maps + Places.
# Si NO se define, se usa OpenStreetMap (Leaflet) + búsqueda Nominatim, sin key.
# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""

# Correo de contacto para las peticiones a Nominatim (buena práctica, opcional).
# NOMINATIM_CONTACT_EMAIL="tucorreo@ejemplo.com"
